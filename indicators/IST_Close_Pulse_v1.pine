    table.cell(myTable, 0, 3, "09:30 IST (Today)", text_color = color.black, text_size = font_size)
    table.cell(myTable, 1, 3, "09:30 IST", text_color = color.black, text_size = font_size)
    table.cell(myTable, 2, 3, str.tostring(opening_price, format.mintick), text_color = color.black, text_size = font_size)

    table.cell(myTable, 0, 4, "9:30 IST (Prev)", text_color = color.black, text_size = font_size)
    table.cell(myTable, 1, 4, "9:30 IST", text_color = color.black, text_size = font_size)
    table.cell(myTable, 2, 4, str.tostring(prev_opening_price, format.mintick), text_color = color.black, text_size = font_size)

    table.cell(myTable, 0, 5, "15:30 IST (Today)", text_color = color.black, text_size = font_size)
    table.cell(myTable, 1, 5, "15:30 IST", text_color = color.black, text_size = font_size)
    table.cell(myTable, 2, 5, str.tostring(closing_price, format.mintick), text_color = color.black, text_size = font_size)

    table.cell(myTable, 0, 6, "15:30 IST (Prev)", text_color = color.black, text_size = font_size)
    table.cell(myTable, 1, 6, "15:30 IST", text_color = color.black, text_size = font_size)
    table.cell(myTable, 2, 6, str.tostring(prev_closing_price, format.mintick), text_color = color.black, text_size = font_size)

    table.cell(myTable, 0, 7, "Mon-O", text_color = color.black, text_size = font_size)
    table.cell(myTable, 1, 7, "00:00 UTC-4", text_color = color.black, text_size = font_size)
    table.cell(myTable, 2, 7, str.tostring(mon_o, format.mintick), text_color = color.black, text_size = font_size)

    table.cell(myTable, 0, 8, "Mon-C", text_color = color.black, text_size = font_size)
    table.cell(myTable, 1, 8, "23:59 UTC-4", text_color = color.black, text_size = font_size)
    table.cell(myTable, 2, 8, str.tostring(mon_c, format.mintick), text_color = color.black, text_size = font_size)

    table.cell(myTable, 0, 9, "Tue-O", text_color = color.black, text_size = font_size)
    table.cell(myTable, 1, 9, "00:00 UTC-4", text_color = color.black, text_size = font_size)
    table.cell(myTable, 2, 9, str.tostring(tue_o, format.mintick), text_color = color.black, text_size = font_size)

    table.cell(myTable, 0, 10, "Tue-C", text_color = color.black, text_size = font_size)
    table.cell(myTable, 1, 10, "23:59 UTC-4", text_color = color.black, text_size = font_size)
    table.cell(myTable, 2, 10, str.tostring(tue_c, format.mintick), text_color = color.black, text_size = font_size)

    table.cell(myTable, 0, 11, "Wk-H", text_color = color.black, text_size = font_size)
    table.cell(myTable, 1, 11, str.format_time(weekly_high_time, "yyyy-MM-dd HH:mm", TZ_IST) + " IST", text_color = color.black, text_size = font_size)
    table.cell(myTable, 2, 11, str.tostring(weekly_high, format.mintick), text_color = color.black, text_size = font_size)

