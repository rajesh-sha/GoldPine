    table.cell(weeklyTable, 2, 4, str.tostring(in_thu_open, "#.##"), text_size = font_size)
    table.cell(weeklyTable, 3, 4, str.tostring(in_thu_close, "#.##"), text_size = font_size)
    table.cell(weeklyTable, 1, 5, str.format_time(in_fri_date, "yyyy-MM-dd", TZ_IST), text_size = font_size)
    table.cell(weeklyTable, 2, 5, str.tostring(in_fri_open, "#.##"), text_size = font_size)
    table.cell(weeklyTable, 3, 5, str.tostring(in_fri_close, "#.##"), text_size = font_size)

var table prev_weeklyTable = table.new(prev_week_data_table_pos, 4, 6, bgcolor = bg_color, border_color = color.black, frame_color = color.black, frame_width = 2, border_width = 2)

if show_prev_week_data_table and (barstate.islast or barstate.islastconfirmedhistory)
    table.cell(prev_weeklyTable, 0, 0, "Day",          bgcolor = color.gray, text_color = color.white, text_size = font_size)
    table.cell(prev_weeklyTable, 1, 0, "Date",         bgcolor = color.gray, text_color = color.white, text_size = font_size)
    table.cell(prev_weeklyTable, 2, 0, "9:30 IST - O", bgcolor = color.gray, text_color = color.white, text_size = font_size)
    table.cell(prev_weeklyTable, 3, 0, "15:30 IST - C", bgcolor = color.gray, text_color = color.white, text_size = font_size)

    table.cell(prev_weeklyTable, 0, 1, "Pr. Mon", bgcolor = color.white, text_color = color.black, text_size = font_size)
    table.cell(prev_weeklyTable, 0, 2, "Pr. Tue", bgcolor = color.white, text_color = color.black, text_size = font_size)
    table.cell(prev_weeklyTable, 0, 3, "Pr. Wed", bgcolor = color.white, text_color = color.black, text_size = font_size)
