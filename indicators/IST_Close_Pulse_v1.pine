    table.cell(prev_weeklyTable, 0, 5, "Pr. Fri", bgcolor = color.white, text_color = color.black, text_size = font_size)

    table.cell(prev_weeklyTable, 1, 1, str.format_time(in_mon_date_prev, "yyyy-MM-dd", TZ_IST), text_size = font_size)
    table.cell(prev_weeklyTable, 2, 1, str.tostring(in_mon_open_prev, "#.##"), text_size = font_size)
    table.cell(prev_weeklyTable, 3, 1, str.tostring(in_mon_close_prev, "#.##"), text_size = font_size)
    table.cell(prev_weeklyTable, 1, 2, str.format_time(in_tue_date_prev, "yyyy-MM-dd", TZ_IST), text_size = font_size)
    table.cell(prev_weeklyTable, 2, 2, str.tostring(in_tue_open_prev, "#.##"), text_size = font_size)
    table.cell(prev_weeklyTable, 3, 2, str.tostring(in_tue_close_prev, "#.##"), text_size = font_size)
    table.cell(prev_weeklyTable, 1, 3, str.format_time(in_wed_date_prev, "yyyy-MM-dd", TZ_IST), text_size = font_size)
    table.cell(prev_weeklyTable, 2, 3, str.tostring(in_wed_open_prev, "#.##"), text_size = font_size)
    table.cell(prev_weeklyTable, 3, 3, str.tostring(in_wed_close_prev, "#.##"), text_size = font_size)
    table.cell(prev_weeklyTable, 1, 4, str.format_time(in_thu_date_prev, "yyyy-MM-dd", TZ_IST), text_size = font_size)
    table.cell(prev_weeklyTable, 2, 4, str.tostring(in_thu_open_prev, "#.##"), text_size = font_size)
    table.cell(prev_weeklyTable, 3, 4, str.tostring(in_thu_close_prev, "#.##"), text_size = font_size)
