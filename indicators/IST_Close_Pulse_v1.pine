    table.cell(myTable, 2, 12, str.tostring(weekly_low, format.mintick), text_color = color.black, text_size = font_size)

    table.cell(myTable, 0, 13, "Mo-H", text_color = color.black, text_size = font_size)
    table.cell(myTable, 1, 13, str.format_time(monthly_high_time, "yyyy-MM-dd HH:mm", TZ_IST) + " IST", text_color = color.black, text_size = font_size)
    table.cell(myTable, 2, 13, str.tostring(monthly_high, format.mintick), text_color = color.black, text_size = font_size)

    table.cell(myTable, 0, 14, "Mo-L", text_color = color.black, text_size = font_size)
    table.cell(myTable, 1, 14, str.format_time(monthly_low_time, "yyyy-MM-dd HH:mm", TZ_IST) + " IST", text_color = color.black, text_size = font_size)
    table.cell(myTable, 2, 14, str.tostring(monthly_low, format.mintick), text_color = color.black, text_size = font_size)

    table.cell(myTable, 0, 15, "8:00 AM Today", text_color = color.black, text_size = font_size)
    table.cell(myTable, 1, 15, "8:00 AM " + price_timezone_8AM, text_color = color.black, text_size = font_size)
    table.cell(myTable, 2, 15, str.tostring(eightAM_price, format.mintick), text_color = color.black, text_size = font_size)

    table.cell(myTable, 0, 16, "8:00 AM Prev", text_color = color.black, text_size = font_size)
    table.cell(myTable, 1, 16, "8:00 AM " + price_timezone_8AM, text_color = color.black, text_size = font_size)
    table.cell(myTable, 2, 16, str.tostring(eightAM_prev_price, format.mintick), text_color = color.black, text_size = font_size)

plot(daily_high, "Daily High", color = color.rgb(140, 140, 140, 43))
plot(daily_low,  "Daily Low",  color = color.rgb(140, 140, 140, 43))

// ═══════════════════════════ FLOATING LABELS ═══════════════════════════
var array<label> labels_arr = array.new_label()
label_arr_size = array.size(labels_arr)
if label_arr_size
    for i = 0 to label_arr_size - 1
        label.delete(array.get(labels_arr, i))
array.clear(labels_arr)

if show_threshold_data
    if longCondition
        label.new(bar_index, high, text = "Up : " + str.tostring(up_perc * 100, format.mintick) + "%\nDown : " + str.tostring(down_perc * 100, format.mintick) + "%", color = color.rgb(187, 187, 187, 43), textcolor = color.black)
    else if shortCondition
        label.new(bar_index, low, style = label.style_label_up, text = "Up : " + str.tostring(up_perc * 100, format.mintick) + "%\nDown : " + str.tostring(down_perc * 100, format.mintick) + "%", color = color.rgb(187, 187, 187, 43), textcolor = color.black)
    else if bar_index == obs_end_index
        label.new(bar_index, high, text = "Up : " + str.tostring(up_perc * 100, format.mintick) + "%\nDown : " + str.tostring(down_perc * 100, format.mintick) + "%", color = color.rgb(187, 187, 187, 43), textcolor = color.black)

f_pushLbl(bool on, float y, string txt) =>
    if on and not na(y)
        array.push(labels_arr, label.new(bar_index + 2, y, txt, color = color.rgb(187, 187, 187, 43), textcolor = color.black, style = label.style_label_left, size = size.small))

f_pushLbl(show_daily_high,         daily_high,         "Day High: " + str.tostring(daily_high, format.mintick))
f_pushLbl(show_daily_low,          daily_low,          "Day Low: " + str.tostring(daily_low, format.mintick))
f_pushLbl(show_opening_price,      opening_price,      "9:30 IST: " + str.tostring(opening_price, format.mintick))
f_pushLbl(show_prev_opening_price, prev_opening_price, "Prev 9:30 IST: " + str.tostring(prev_opening_price, format.mintick))
f_pushLbl(show_closing_price,      closing_price,      "15:30 IST: " + str.tostring(closing_price, format.mintick))
f_pushLbl(show_prev_closing_price, prev_closing_price, "Prev 15:30 IST: " + str.tostring(prev_closing_price, format.mintick))
// Fixed label text (original said "Prev 15:30 IST" for Mon-O)
f_pushLbl(show_mon_open,     mon_o,         "Mon-O: " + str.tostring(mon_o, format.mintick))
f_pushLbl(show_mon_close,    mon_c,         "Mon-C: " + str.tostring(mon_c, format.mintick))
f_pushLbl(show_tue_open,     tue_o,         "Tue-O: " + str.tostring(tue_o, format.mintick))
f_pushLbl(show_tue_close,    tue_c,         "Tue-C: " + str.tostring(tue_c, format.mintick))
f_pushLbl(show_weekly_high,  weekly_high,   "Wk-H: " + str.tostring(weekly_high, format.mintick))
f_pushLbl(show_weekly_low,   weekly_low,    "Wk-L: " + str.tostring(weekly_low, format.mintick))
f_pushLbl(show_monthly_high, monthly_high,  "Mo-H: " + str.tostring(monthly_high, format.mintick))
f_pushLbl(show_monthly_low,  monthly_low,   "Mo-L: " + str.tostring(monthly_low, format.mintick))

plot(show_mon_open and not na(mon_o) ? mon_o : na, color = color.red, linewidth = 1)
plot(show_mon_close and not na(mon_c) ? mon_c : na, color = color.green, linewidth = 1)
plot(show_tue_open and not na(tue_o) ? tue_o : na, color = color.blue, linewidth = 1)
plot(show_tue_close and not na(tue_c) ? tue_c : na, color = color.purple, linewidth = 1)
plot(show_weekly_high and not na(weekly_high) ? weekly_high : na, color = color.yellow, linewidth = 1)
plot(show_weekly_low and not na(weekly_low) ? weekly_low : na, color = color.orange, linewidth = 1)
plot(show_monthly_high and not na(monthly_high) ? monthly_high : na, color = color.teal, linewidth = 1)
plot(show_monthly_low and not na(monthly_low) ? monthly_low : na, color = color.fuchsia, linewidth = 1)

// ═══════════════════════════ MON-C / TUE-C ZONE TABLE ═══════════════════════════
current_price = close
string condition_below   = str.tostring(close) + " < " + str.tostring(mon_c)
string condition_between = str.tostring(mon_c) + " <= " + str.tostring(close) + " <= " + str.tostring(tue_c)
string condition_above   = str.tostring(close) + " > " + str.tostring(tue_c)

color color_below = na
color color_between = na
color color_above = na
float diff_below = na
float diff_between_1 = na
float diff_between_2 = na
float diff_above = na

if current_price < mon_c
    color_below := color.red
    diff_below := mon_c - close
if current_price >= mon_c and current_price <= tue_c
    color_between := color.yellow
    diff_between_1 := mon_c - current_price
    diff_between_2 := tue_c - current_price
if current_price > tue_c
    color_above := color.green
    diff_above := close - tue_c

var table price_table = table.new(price_table_pos, 4, 4, bgcolor = bg_color, border_color = color.black, frame_color = color.black, frame_width = 2, border_width = 2)

if show_price_table and (barstate.islast or barstate.islastconfirmedhistory)
    table.cell(price_table, 0, 0, "Condition",       text_color = color.black, bgcolor = color.new(color.gray, 80), text_size = font_size)
    table.cell(price_table, 1, 0, "Status",          text_color = color.black, bgcolor = color.new(color.gray, 80), text_size = font_size)
    table.cell(price_table, 2, 0, "Color Code",      text_color = color.black, bgcolor = color.new(color.gray, 80), text_size = font_size)
    table.cell(price_table, 3, 0, "Price Difference", text_color = color.black, bgcolor = color.new(color.gray, 80), text_size = font_size)

    table.cell(price_table, 0, 1, condition_below, text_color = color.black, text_size = font_size)
    table.cell(price_table, 1, 1, "Below Mon-C", text_color = color.black, text_size = font_size)
    table.cell(price_table, 2, 1, current_price < mon_c ? "Red" : na, text_color = color.black, bgcolor = color_below, text_size = font_size)
    table.cell(price_table, 3, 1, str.tostring(diff_below, format.mintick), text_color = color.black, text_size = font_size)

    table.cell(price_table, 0, 2, condition_between, text_color = color.black, text_size = font_size)
    table.cell(price_table, 1, 2, "Between Mon-C & Tue-C", text_color = color.black, text_size = font_size)
    table.cell(price_table, 2, 2, current_price >= mon_c and current_price <= tue_c ? "Yellow" : na, text_color = color.black, bgcolor = color_between, text_size = font_size)
    table.cell(price_table, 3, 2, str.tostring(diff_between_1, format.mintick) + " / " + str.tostring(diff_between_2, format.mintick), text_color = color.black, text_size = font_size)

    table.cell(price_table, 0, 3, condition_above, text_color = color.black, text_size = font_size)
    table.cell(price_table, 1, 3, "Above Tue-C", text_color = color.black, text_size = font_size)
    table.cell(price_table, 2, 3, current_price > tue_c ? "Green" : na, text_color = color.black, bgcolor = color_above, text_size = font_size)
    table.cell(price_table, 3, 3, str.tostring(diff_above, format.mintick), text_color = color.black, text_size = font_size)

// ═══════════════════════════ WEEK / PREV-WEEK TABLES ═══════════════════════════
var table weeklyTable = table.new(week_data_table_pos, 4, 6, bgcolor = bg_color, border_color = color.black, frame_color = color.black, frame_width = 2, border_width = 2)

if show_week_data_table and (barstate.islast or barstate.islastconfirmedhistory)
    table.cell(weeklyTable, 0, 0, "Day",          bgcolor = color.gray, text_color = color.white, text_size = font_size)
