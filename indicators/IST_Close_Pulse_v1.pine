    table.cell(weeklyTable, 2, 0, "9:30 IST - O", bgcolor = color.gray, text_color = color.white, text_size = font_size)
    table.cell(weeklyTable, 3, 0, "15:30 IST - C", bgcolor = color.gray, text_color = color.white, text_size = font_size)

    table.cell(weeklyTable, 0, 1, "Mon", bgcolor = color.white, text_color = color.black, text_size = font_size)
    table.cell(weeklyTable, 0, 2, "Tue", bgcolor = color.white, text_color = color.black, text_size = font_size)
    table.cell(weeklyTable, 0, 3, "Wed", bgcolor = color.white, text_color = color.black, text_size = font_size)
    table.cell(weeklyTable, 0, 4, "Thu", bgcolor = color.white, text_color = color.black, text_size = font_size)
    table.cell(weeklyTable, 0, 5, "Fri", bgcolor = color.white, text_color = color.black, text_size = font_size)

    table.cell(weeklyTable, 1, 1, str.format_time(in_mon_date, "yyyy-MM-dd", TZ_IST), text_size = font_size)
    table.cell(weeklyTable, 2, 1, str.tostring(in_mon_open, "#.##"), text_size = font_size)
    table.cell(weeklyTable, 3, 1, str.tostring(in_mon_close, "#.##"), text_size = font_size)
    table.cell(weeklyTable, 1, 2, str.format_time(in_tue_date, "yyyy-MM-dd", TZ_IST), text_size = font_size)
    table.cell(weeklyTable, 2, 2, str.tostring(in_tue_open, "#.##"), text_size = font_size)
