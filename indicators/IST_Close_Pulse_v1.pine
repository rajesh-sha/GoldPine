    table.cell(weeklyTable, 1, 3, str.format_time(in_wed_date, "yyyy-MM-dd", TZ_IST), text_size = font_size)
    table.cell(weeklyTable, 2, 3, str.tostring(in_wed_open, "#.##"), text_size = font_size)
